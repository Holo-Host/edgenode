# Built Worker bundles — generated by apply.sh
dist/

# OpenTofu local state and lock files
tofu/.terraform/
tofu/.terraform.lock.hcl
tofu/terraform.tfstate
tofu/terraform.tfstate.backup
tofu/*.tfstate
tofu/*.tfstate.backup
tofu/terraform.tfstate.d/

# Per-deployment tfvars — copy from example.tfvars, never commit
tofu/*.tfvars
!tofu/example.tfvars

# Populated secrets files — never commit
.env.*
!.env.example

# Bootstrap results (contain agent keys)
results/
