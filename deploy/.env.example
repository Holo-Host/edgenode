# Edge Node Cloud Deployment — Environment Variables
#
# Copy this file to .env.<org>-<env> and fill in your values.
# Source it before running any deploy scripts:
#
#   cp deploy/.env.example deploy/.env.acme-staging
#   $EDITOR deploy/.env.acme-staging
#   source deploy/.env.acme-staging
#   ./deploy/scripts/apply.sh acme staging
#
# Never commit .env.* files — they are gitignored.

# --- Hetzner Cloud ---
HCLOUD_TOKEN=""

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# Workers subdomain (found in Workers & Pages → Overview → Your subdomain)
CLOUDFLARE_WORKERS_SUBDOMAIN=""
# Zone ID for the domain used by this deployment (found in the Cloudflare dashboard Overview tab)
CLOUDFLARE_ZONE_ID=""

# --- SSH ---
# Contents of the SSH public key to install on Hetzner VMs (e.g. ~/.ssh/id_ed25519.pub)
SSH_PUBLIC_KEY=""

# --- Joining Service / h2hc-linker ---
# Kitsune2 bootstrap server URL (required — enables the h2hc-linker service).
H2HC_LINKER_BOOTSTRAP_URL=""
# Shared secret between h2hc-linker and the joining service Worker (optional auth layer).
LINKER_ADMIN_SECRET=""
# Comma-separated invite codes for HWC browser nodes.
INVITE_CODES="test-invite-123"

# --- Unyt / Log-Sender (edgenode) ---
# URL of the Cloudflare log-collector Worker.
LOG_SENDER_ENDPOINT=""
# Unyt agent public key (uhCAk...) of the party paying for resources.
LOG_SENDER_UNYT_PUB_KEY=""

# --- Harvester ---
# URL of the Cloudflare log-collector Worker (same as LOG_SENDER_ENDPOINT).
COLLECTOR_URL=""
# Admin secret for the log-collector.
ADMIN_SECRET=""
# Lair keystore password for the harvester Holochain conductor.
HARVESTER_LAIR_PASSWORD=""

# --- edgenode container ---
# Lair keystore password for the Holochain conductor.
LAIR_PASSWORD=""

# --- Harvester bootstrap (deploy/scripts/bootstrap-harvester.sh) ---
# Network seed for the Unyt hApp cell on the harvester conductor.
HARVESTER_NETWORK_SEED=""
# Path to the joining service config JSON (e.g. in your unyt-sandbox checkout).
JOINING_SERVICE_CONFIG_PATH=""
# Path to the joining service deploy script.
JOINING_SERVICE_DEPLOY_SCRIPT=""
# Optional: path to the joining service signing key file.
JOINING_SERVICE_SIGNING_KEY_FILE=""

# --- OpenTofu variable passthrough ---
# These map env vars to TF_VAR_* so tofu picks them up automatically.
export TF_VAR_hcloud_token="$HCLOUD_TOKEN"
export TF_VAR_cloudflare_account_id="$CLOUDFLARE_ACCOUNT_ID"
export TF_VAR_cloudflare_api_token="$CLOUDFLARE_API_TOKEN"
export TF_VAR_cloudflare_workers_subdomain="$CLOUDFLARE_WORKERS_SUBDOMAIN"
export TF_VAR_cloudflare_zone_id="$CLOUDFLARE_ZONE_ID"
export TF_VAR_ssh_public_key="$SSH_PUBLIC_KEY"
export TF_VAR_linker_bootstrap_url="$H2HC_LINKER_BOOTSTRAP_URL"
export TF_VAR_linker_admin_secret="$LINKER_ADMIN_SECRET"
export TF_VAR_invite_codes="$INVITE_CODES"
export TF_VAR_lair_password="$LAIR_PASSWORD"
export TF_VAR_harvester_lair_password="$HARVESTER_LAIR_PASSWORD"
export TF_VAR_log_sender_unyt_pub_key="$LOG_SENDER_UNYT_PUB_KEY"
export TF_VAR_log_collector_admin_secret="$ADMIN_SECRET"
