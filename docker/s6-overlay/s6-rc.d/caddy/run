#!/command/with-contenv /bin/sh
set -e

# Auto-enabled when CADDY_DOMAIN is set (implies linker is also configured)
if [ -z "${CADDY_DOMAIN:-}" ] || [ -z "${H2HC_LINKER_ADMIN_SECRET:-}" ]; then
  exec tail -f /dev/null
fi

echo "Starting Caddy reverse proxy for ${CADDY_DOMAIN}..." >> /data/logs/startup.log

# Generate Caddyfile pointing at the linker's local port
cat > /tmp/Caddyfile << EOF
${CADDY_DOMAIN} {
    reverse_proxy localhost:${H2HC_LINKER_PORT:-8080}
}
EOF

exec caddy run --config /tmp/Caddyfile >> /data/logs/caddy.log 2>&1
