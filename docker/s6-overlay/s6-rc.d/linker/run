#!/command/with-contenv /bin/sh
set -e

# Auto-enabled when H2HC_LINKER_BOOTSTRAP_URL is set
if [ -z "${H2HC_LINKER_BOOTSTRAP_URL:-}" ]; then
  exec tail -f /dev/null
fi

echo "Starting h2hc-linker..." >> /data/logs/startup.log

# h2hc-linker is configured entirely via environment variables.
# H2HC_LINKER_BOOTSTRAP_URL — required (set above)
# H2HC_LINKER_ADDRESS      — bind address; default 127.0.0.1, override to 0.0.0.0 in container
# H2HC_LINKER_PORT         — listen port; default 8080
# H2HC_LINKER_ADMIN_SECRET — optional, enables auth layer
# H2HC_LINKER_CONDUCTOR_URL — optional, enables zome call proxying
export H2HC_LINKER_ADDRESS="${H2HC_LINKER_ADDRESS:-0.0.0.0}"

exec gosu nonroot h2hc-linker >> /data/logs/linker.log 2>&1
