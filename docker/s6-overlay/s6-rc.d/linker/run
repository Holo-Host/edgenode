#!/command/with-contenv /bin/sh
set -e

# Auto-enabled when H2HC_LINKER_ADMIN_SECRET is set
if [ -z "${H2HC_LINKER_ADMIN_SECRET:-}" ]; then
  exec tail -f /dev/null
fi

# Wait for conductor admin port to be ready
echo "Linker waiting for holochain conductor..." >> /data/logs/startup.log
while ! hc sandbox call --running "${HC_ADMIN_PORT:-4444}" list-apps > /dev/null 2>&1; do
  sleep 5
done
echo "Starting h2hc-linker..." >> /data/logs/startup.log

exec gosu nonroot h2hc-linker \
  --admin-secret "${H2HC_LINKER_ADMIN_SECRET}" \
  --conductor-url "ws://localhost:${HC_ADMIN_PORT:-4444}" \
  --port "${H2HC_LINKER_PORT:-8080}" >> /data/logs/linker.log 2>&1
